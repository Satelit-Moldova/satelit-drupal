{#
/**
 * @file
 * Fuel prices. Variables: rows (label, min, max, cap), cheapest (name, price), date, source.
 */
#}
<div class="satelit satelit--fuel">
  {% if date %}<p class="satelit__date">{{ date }}</p>{% endif %}
  <table class="satelit__table">
    <thead><tr>
      <th scope="col"></th>
      <th scope="col" class="satelit__num">{{ 'From'|t }}</th>
      <th scope="col" class="satelit__num">{{ 'To'|t }}</th>
      <th scope="col" class="satelit__num">{{ 'ANRE cap'|t }}</th>
    </tr></thead>
    <tbody>
    {% for r in rows %}
      <tr><th scope="row">{{ r.label }}</th><td class="satelit__num">{{ r.min }}</td><td class="satelit__num">{{ r.max }}</td><td class="satelit__num">{{ r.cap }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% if cheapest %}
    <p class="satelit__sub">{{ 'Cheapest A95 today'|t }}</p>
    <ol class="satelit__list">
      {% for n in cheapest %}<li>{{ n.name }} <span class="satelit__num">{{ n.price }}</span></li>{% endfor %}
    </ol>
  {% endif %}
  {% include '@satelit/satelit-source.html.twig' %}
</div>
